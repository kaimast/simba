(
    protocol: "snowball",
    network: "a2a_large",

    metrics: [
        Throughput,
        Latency,
        NetworkMessages,
    ],

    data_ranges: [
        (AcceptanceThreshold, LinearInt(start: 5, end: 50, step_size: 5)),
        (HeartbeatInterval, LinearInt(start: 500, end: 2000, step_size: 500)),
        (MaxRounds, LinearInt(start: 500, end: 2000, step_size: 500)),
    ],

    timeout: Blocks(
        warmup: 0,
        runtime: 1,
    ),
)
